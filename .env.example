# Frontend services
VITE_API_BASE_URL=https://api.example.com
VITE_BFF_BASE_URL=https://api.example.com

# Backend (set these in the server environment, not in the frontend build)
DATABASE_URL=postgresql+psycopg://vibra:change-me@db.example.com:5432/vibra
CORS_ORIGINS=https://app.example.com

# Neon — pulled by `neon env pull` / `neon deploy` into .env
# DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_BRANCH are written by the CLI.
# The backend loads DATABASE_URL from the project-root .env automatically.
# NEON_AUTH_BASE_URL / NEON_AUTH_JWKS_URL are pulled too; vite.config.ts
# mirrors NEON_AUTH_BASE_URL to the client as VITE_NEON_AUTH_URL.
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://ep-example.neonauth.example.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-example.neonauth.example.aws.neon.tech/neondb/auth/.well-known/jwks.json
