<?xml version="1.0" encoding="utf-8"?>
<!-- Resource overlay: same name as the Capacitor library layout, so the app's
     copy wins at merge time. Identical structure, but the WebView is
     VibraWebView — which keeps window visibility pinned to VISIBLE so
     backgrounded media playback never gets suspended by Chromium. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.getcapacitor.BridgeActivity"
    >

    <com.vybra.streamvy.me.VibraWebView
        android:id="@+id/webview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
