{
  "appId": "vybra.streamvy.me",
  "appName": "Vybra",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "hostname": "vybra.streamvy.me",
    "allowNavigation": [
      "vybra.streamvy.me",
      "*.google.com",
      "*.googleapis.com",
      "lenium-music-api.onrender.com",
      "*.neonauth.c-7.us-east-2.aws.neon.tech"
    ]
  },
  "plugins": {
    "LiveUpdate": {
      "defaultChannel": "nightly",
      "readyTimeout": 10000,
      "autoUpdateStrategy": "none",
      "autoDeleteBundles": true,
      "autoBlockRolledBackBundles": true
    }
  }
}
